{
  "name": "PTL Cloud Jekyll Website",
  "dockerComposeFile": "../docker-compose-devshell.yml",
  "service": "devshell",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",

  "forwardPorts": [4000, 35729],
  "portsAttributes": {
    "4000": {
      "label": "Jekyll Server",
      "onAutoForward": "notify"
    },
    "35729": {
      "label": "LiveReload",
      "onAutoForward": "silent"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "rebornix.Ruby",
        "sissel.shopify-liquid"
      ]
    }
  }
}
